{
  "name": "perpx",
  "packageManager": "yarn@4.5.2",
  "scripts": {
    "build": "tsc && cp src/rpc/proto/perpx.proto dist/src/rpc/proto/perpx.proto",
    "dev": "yarn run start:envoy:docker & NODE_ENV=development ts-node src/main.ts",
    "test": "NODE_ENV=development ts-node tests/hash.ts",
    "start": "yarn run start:envoy:docker & yarn run start:server",
    "start:server": "yarn run build && NODE_ENV=production node dist/src/main.js",
    "start:envoy": "envoy -c src/rpc/proxy/envoy.yaml",
    "start:envoy:docker": "docker run --rm --name perpx-envoy --add-host=host.docker.internal:host-gateway -p 8080:8080 -v $(pwd)/src/rpc/proxy/envoy.yaml:/etc/envoy/envoy.yaml envoyproxy/envoy:v1.35.4",
    "gen": "protoc --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=src/rpc/proto --ts_proto_opt=outputClientImpl=grpc-web,addGrpcMetadata=true,esModuleInterop=true,forceLong=long,useOptionals=messages -I src/rpc/proto src/rpc/proto/*.proto",
    "encrypt-env": "ts-node src/utils/encrypt-env.ts"
  },
  "devDependencies": {
    "@improbable-eng/grpc-web": "^0.15.0",
    "@types/jsonwebtoken": "^9",
    "@types/node-telegram-bot-api": "^0",
    "@types/readline-sync": "^1",
    "browser-headers": "^0.4.1",
    "ts-node": "^10.9.2",
    "ts-proto": "^2.7.7",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "@tma.js/init-data-node": "^2.0.3",
    "agent-twitter-client": "https:/github.com/xiangxn/agent-twitter-client.git",
    "cycletls": "^2.0.5",
    "dayjs": "^1.11.18",
    "dotenv": "^17.2.1",
    "https-proxy-agent": "^7.0.6",
    "ioredis": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.1",
    "node-telegram-bot-api": "^0.66.0",
    "readline-sync": "^1.4.10"
  }
}
